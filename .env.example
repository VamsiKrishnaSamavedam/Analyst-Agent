# Never commit a real .env file or API key.
GEMINI_API_KEY=replace-with-your-key

# PostgreSQL connection (the database role should have SELECT-only permissions).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ride_analytics
DB_USER=analytics_reader
DB_PASSWORD=replace-with-a-strong-password
# Separate writer account for explicit raw-data staging.
DB_WRITE_HOST=localhost
DB_WRITE_PORT=5432
DB_WRITE_NAME=ride_analytics
DB_WRITE_USER=etl_writer
DB_WRITE_PASSWORD=replace-with-a-strong-password
MAX_UPLOAD_MB=200
LLM_THINKING_LEVEL=medium
MAX_API_RESPONSE_MB=25
DATA_RETENTION_HOURS=24
RATE_LIMIT_PER_MINUTE=30
# Set APP_API_KEY before any non-public deployment; clients send it as X-API-Key.
APP_API_KEY=
